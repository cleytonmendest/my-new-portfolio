# Every NEXT_PUBLIC_ variable is inlined at build time. On Vercel, set them for Production and
# Preview, then redeploy: changing a value does not update a deployment that is already built.

# Contact form access key from https://web3forms.com. Without it, submitting the form opens the
# visitor's email app with the message instead of sending it.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Google Analytics 4 measurement ID, like G-XXXXXXXXXX (optional).
NEXT_PUBLIC_GA_ID=

# Public URL for canonical links, hreflang, the sitemap, robots.txt and JSON-LD (optional).
# On Vercel it defaults to the production URL, locally to http://localhost:3000. Set it for a
# custom domain.
NEXT_PUBLIC_SITE_URL=
