# All NEXT_PUBLIC_* values are inlined at build time. In Docker/Easypanel they must be
# provided as build arguments (see Dockerfile), not only as runtime variables.

# Site URL (production), used for canonical URLs and the sitemap
NEXT_PUBLIC_SITE_URL=https://cleyton-mendes.com

# Google Analytics 4
# Get your GA4 ID from https://analytics.google.com/ (format: G-XXXXXXXXXX)
# Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Web3Forms access key for the contact form
# Get a free key at https://web3forms.com. It ships in the client bundle by design.
# Without it the contact form cannot send messages.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
